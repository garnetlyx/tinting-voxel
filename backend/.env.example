# Application Settings
APP_NAME="ImageToSTL Converter API"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS - Add your production frontend URL here
# Example: CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Color Processing Defaults
DEFAULT_LAYER_COUNT=4
DEFAULT_LAYER_HEIGHT=0.08
DEFAULT_PIXEL_SIZE=0.08
DEFAULT_MAX_COLORS=10
DEFAULT_COLOR_THRESHOLD=50.0

# File Upload Limits
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.bmp,.gif

# Logging
LOG_LEVEL=INFO
